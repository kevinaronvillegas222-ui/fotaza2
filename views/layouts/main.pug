doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title #{title} | FotoShare
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin='')
    link(rel='stylesheet', href='/css/style.css')
    block head

  body
    nav.navbar.navbar-expand-lg
      .container-xl
        a.navbar-brand(href='/publications')
          i.bi.bi-camera-fill(style='font-size:1.3rem;color:#fff')
          | FotoShare
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navMenu')
          span.navbar-toggler-icon
        #navMenu.collapse.navbar-collapse
          ul.navbar-nav.me-auto.gap-1.mt-2.mt-lg-0
            li.nav-item
              a.nav-link(href='/publications') Explorar
            li.nav-item
              a.nav-link(href='/publications/search') Buscar
            if user
              li.nav-item
                a.nav-link(href='/following') Siguiendo
          ul.navbar-nav.align-items-center.gap-2.mt-2.mt-lg-0
            if user
              li.nav-item
                a.btn-nav-post(href='/publications/new')
                  i.bi.bi-plus-lg
                  | Publicar
              li.nav-item
                a.nav-link(href='/notifications', style='position:relative')
                  i.bi.bi-bell(style='font-size:1.05rem')
                  if unreadNotifications > 0
                    span.notif-badge #{unreadNotifications}
              li.nav-item
                a.nav-link(href='/messages')
                  i.bi.bi-chat-dots(style='font-size:1.05rem')
              li.nav-item
                a.nav-link(href='/collections')
                  i.bi.bi-bookmark(style='font-size:1.05rem')
              li.nav-item.dropdown
                a.nav-link.dropdown-toggle(href='#', data-bs-toggle='dropdown', style='display:flex;align-items:center;gap:.4rem')
                  .comment-avatar(style='width:28px;height:28px;font-size:.72rem')
                    if user.avatar
                      img(src=`/uploads/avatars/${user.avatar}`)
                    else
                      | #{user.username.charAt(0).toUpperCase()}
                  span(style='font-size:.85rem;font-weight:600;color:#888') #{user.username}
                ul.dropdown-menu.dropdown-menu-end
                  li: a.dropdown-item(href=`/users/${user.username}`)
                    i.bi.bi-person.me-2
                    | Mi perfil
                  if user.role === 'validator' || user.role === 'admin'
                    li: a.dropdown-item(href='/validator')
                      i.bi.bi-shield-check.me-2
                      | Panel Validador
                  li: hr.dropdown-divider
                  li: a.dropdown-item(href='/auth/logout', style='color:#e05555')
                    i.bi.bi-box-arrow-right.me-2
                    | Cerrar sesión
            else
              li.nav-item
                a.nav-link(href='/auth/login') Iniciar sesión
              li.nav-item
                a.btn-nav-post(href='/auth/register') Registrarse

    main.main-wrap
      block content

    footer
      span.footer-brand FotoShare
      p.mt-1 Desarrollado por #[a(href='#') Villegas Kevin Aron]
      p.mt-1 Programación Web II · Universidad de La Punta
      p.mt-1 &copy; 2026 · Todos los derechos reservados
      .mt-2
        a.nav-link.d-inline(href='/publications') Explorar
        span.text-muted  ·  
        a.nav-link.d-inline(href='/publications/search') Buscar
        span.text-muted  ·  
        a.nav-link.d-inline(href='/auth/register') Registrarse

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    block scripts
