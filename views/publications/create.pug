extends ../layouts/main

block content
  .row.justify-content-center
    .col-lg-7
      .panel
        .panel__header
          span
            i.bi.bi-plus-circle.me-2
            | Nueva publicación
        .panel__body
          if errors && errors.length
            .alert.alert-danger.mb-3
              each e in errors
                div= e.msg
          form(method='POST', action='/publications/new', enctype='multipart/form-data')
            .mb-3
              label.form-label Título *
              input.form-control(type='text', name='title', value=old.title || '', required, placeholder='Un título descriptivo para tu publicación')
            .mb-3
              label.form-label Descripción
              textarea.form-control(name='description', rows='3', placeholder='Contá algo sobre estas fotos...') #{old.description || ''}
            .mb-3
              label.form-label Imágenes * (máx. 10)
              input.form-control(type='file', name='images', multiple, accept='image/*', required)
              .form-text(style='font-size:.78rem;color:#aaa') JPG, PNG, WEBP, GIF · Máximo 10MB por imagen
            .mb-3
              label.form-label Etiquetas * (separadas por coma)
              input.form-control(type='text', name='tags', value=old.tags || '', placeholder='naturaleza, paisaje, retrato')
            .row.g-3.mb-4
              .col-md-6
                label.form-label Licencia
                select.form-select(name='license')
                  option(value='free') Sin copyright (libre)
                  option(value='copyright') Con copyright
              .col-md-6
                label.form-label Texto de marca de agua
                input.form-control(type='text', name='watermark_text', placeholder='© Tu Nombre 2025')
                .form-text(style='font-size:.78rem;color:#aaa') Solo para imágenes con copyright
            .d-flex.gap-2
              button.btn-brand(type='submit', style='width:auto;padding:.6rem 2rem')
                i.bi.bi-cloud-upload.me-1
                | Publicar
              a(href='/publications', style='display:inline-flex;align-items:center;padding:.6rem 1.2rem;border-radius:50px;border:1.5px solid var(--border);font-size:.9rem;font-weight:600;text-decoration:none;color:var(--text-muted)') Cancelar

.form-text(style='font-size:.75rem;color:#555') Las imágenes con copyright quedarán protegidas con marca de agua.
