extends ../layouts/main

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    .section-title(style='margin-bottom:0')
      span
      | Notificaciones
    form(method='POST', action='/notifications/read-all')
      button(type='submit', style='border:none;background:none;color:var(--brand-1);font-size:.85rem;font-weight:600;cursor:pointer') Marcar todas leídas

  .panel
    if notifications.length === 0
      .empty-state
        i.bi.bi-bell-slash
        p No tenés notificaciones.
    else
      each n in notifications
        .notif-item(class=n.is_read ? '' : 'unread')
          .notif-icon(class=n.type)
            if n.type === 'comment'
              i.bi.bi-chat-fill
            else if n.type === 'rating'
              i.bi.bi-star-fill
            else if n.type === 'interested'
              i.bi.bi-heart-fill
            else
              i.bi.bi-person-plus-fill
          div(style='flex:1')
            span(style='font-weight:600') @#{n.actor_username}
            |  
            if n.type === 'comment'
              | comentó tu publicación
            else if n.type === 'rating'
              | valoró una de tus imágenes
            else if n.type === 'interested'
              | marcó "me interesa" en una de tus imágenes
            else
              | comenzó a seguirte
            br
            small(style='color:var(--text-muted)') #{new Date(n.created_at).toLocaleString('es-AR')}
          .d-flex.gap-2.align-items-center
            if n.publication_id
              a.btn-action(href=`/publications/${n.publication_id}`, style='padding:.3rem .8rem;font-size:.78rem') Ver
            if !n.is_read
              form(method='POST', action=`/notifications/${n.id}/read`)
                button.btn-action(type='submit', style='padding:.3rem .8rem;font-size:.78rem') ✓
